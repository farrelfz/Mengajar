# ============================================================
# KIR AI Document Intelligence — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# Application Environment (development | production | test)
KIR_APP_ENV=development
KIR_LOG_LEVEL=INFO
KIR_LOG_TO_FILE=false

# AI Provider — 9Router (Cloud Routing)
KIR_NINE_ROUTER_API_KEY=your_9router_api_key_here
KIR_NINE_ROUTER_BASE_URL=https://api.9router.io/v1
KIR_NINE_ROUTER_TIMEOUT=60.0
KIR_NINE_ROUTER_MAX_RETRIES=3

# AI Provider — Ollama (Local/Offline)
KIR_OLLAMA_BASE_URL=http://localhost:11434
KIR_OLLAMA_TIMEOUT=120.0
KIR_OLLAMA_DEFAULT_MODEL=llama3.1:8b

# AI Provider Selection (auto | 9router | ollama)
KIR_PRIMARY_PROVIDER=auto
KIR_FALLBACK_TO_OLLAMA=true
KIR_OFFLINE_MODE=false
KIR_AI_TIMEOUT_SECONDS=60.0

# Intelligence Pipeline
KIR_MAX_REPAIR_ATTEMPTS=2
KIR_MIN_CONFIDENCE_THRESHOLD=0.4
KIR_ENABLE_RESEARCH_TRACEABILITY=true
KIR_ENABLE_SOURCE_FIDELITY_CHECK=true
